! The EOS table of CZ_3D (and CZTR): the same parameters as eos_hhe's
! examples/table_falcon.nml. Generated by `make data` with eos_hhe's
! eos_table_gen into data/eos_table.bin (not kept in the repository).
&eos_table
  output = 'data/eos_table.bin'
  X = 0.75, Z = 0.02, coulomb = .true.
  rho_min = 1.0e-21, rho_max = 0.3, n_rho = 850
  s_min_kmh = 10.0, s_max_kmh = 110.0, n_s = 1740
/

! One-step snapshot of the region around the real047_atm_crashbox crash
! (2026-11-16): the full state in every cell within 15 deg of the crash site,
! z -0.5..150 Mm (~0.5 M cells, ~120 MB), one step after the last restart
! before the crash, for field-line tracing (the loops through the crash
! columns, their other footpoints). A plt would be ~13 GB at 0.47 deg.
! restart_from: the LAST restart of real047_atm_crashbox (edit XXXXXXXX).
!   sbatch -N 4 --ntasks-per-node 112 -t 00:30:00 tools/job.stampede3_spr4 runs/real047_atm_snapbox.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  restart_from = '/scratch/09595/xianyu2023/CZTR_3D_out/real047_atm_crashbox/restart_XXXXXXXX.rst'
  restart_new_output = .true.
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/real047_atm_snapbox'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'cz'
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'dpf', dpf_maxit = 5000, b_seed_rss_rsun = 2.5
  b_bc_bottom = 'conductor', b_bc_top = 'radial'
  va_dt_target = 0.3, va_floor_cs = 1.5
  cond_along_b = .true., b_iso_G = 1.0e-3
  H_B = 4.0e-5, lambda_B_km = 4.0e4, n_gate = 2.0e11, H_B_sat_G = 50.0
  dt1 = 1.0e4
  t_end = 1.0e9, n_step_max = 1, dt_max = 1.0e4
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 30.0
  dump_shells = 196, 197, 225, 244, 252, 280, 350, 450
  box_lat_deg = -3.5, box_lon_deg = 68.7, box_radius_deg = 15.0, box_z_km = -500.0, 150000.0, box_every = 1
  wall_time_margin = 900.0

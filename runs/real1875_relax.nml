! Frozen-CZ relaxation of the atmosphere over the real field, at 1.875 deg on
! the Studio (CZ_3D's mhd5 state at day 65.3, coarsened to 1.875 deg by
! tools/coarsen_export.py from the 0.47 deg export, CZ_3D/runs/export_mhd5.nml):
! the CZ blocks imported (frozen), the atmosphere from data/init_wind20_dip.dat
! (one profile everywhere), the field above the join the PFSS of the CZ's
! photospheric B_r, truncated at l_max = 24 (a quarter of the grid limit
! pi/dtheta = 96). First try at l = 96 (2026-11-12): NaN after 264 steps at
! the TR base (cell 244): the near-grid-scale part of the field is not
! curl-free in the code's differences, and the spurious Lorentz force drove
! Alfvenic flows in the low corona (40-step tests, max |v_h| at 5 Mm: 143
! km/s at l = 96, 37 at 48, 4 at 24; the same with H_B off, so not the
! heating). At l = 24, 92% of rms B_r stays unfitted: a B_r jump at the
! join for GLM, and the small scales enter with the CZ's own evolution.
! Second try at l = 24: NaN again at the TR base (cell 242, 872 steps). The
! real cause: the background rho0 followed the initial TR (rho/rho0 1.15-1.9
! at 1.5-1.7 Mm); with the field the TR height varies by column (1330-1975
! km), and where it sits lower rho ~ 0.1 rho0. Now data/init_wind20_dip_m600.dat:
! the same state, the background built with --tr-margin-km 600 (rho0 below
! the state as if its TR were 600 km lower: rho/rho0 >= 26 at 1.5-1.7 Mm).
! Third try (l = 24 with the margin background): NaN again, at the same
! cell: the corner of a Yin block at the patch corner (lat -44, lon 134; the
! l = 96 crash: a Yang patch edge); min(rho1/rho0) now stayed ~ -0.27 until
! the jump. The user: the field is not force free (the dipole run's field
! matched the CZ's; here 92% of B_r at the join is unfitted, and the rest is
! not discretely curl free). Now friction for the first steps (v_damp_n = 5:
! v_h and v_r - v_r,init damped with a 5-step time; 5000 steps, ramped off
! over 3000): the field and the atmosphere relax towards force balance
! through damped Alfven waves (a pure field relaxation, magnetofriction,
! would be diffusive: ~(7 Mm/30 km)^2 iterations). 40-step test: max|v_h|
! 2 km/s at the TR (8 without), the wind kept.
! Local time stepping, no cap in the atmosphere (dt1, dt_max large); profiles
! every 200 steps, ~1.5 s per step
! on 8 ranks. Before it: tools/coarsen_export.py <CZ_3D export_mhd5> <..._1875>.
!   mpirun -np 8 ./cztr3d.x runs/real1875_relax.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '../CZ_3D/output_stampede3/export_mhd5_1875'
  out_dir = 'output/real1875_relax'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 0, nb_r = 28
  use_atmosphere = .true., freeze_cz = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'pfss', pfss_lmax = 24, b_seed_rss_rsun = 2.5
  b_bc_bottom = 'conductor', b_bc_top = 'radial'
  va_dt_target = 0.3, va_floor_cs = 1.5
  cond_along_b = .true., b_iso_G = 1.0e-3
  H_B = 4.0e-5, lambda_B_km = 4.0e4, n_gate = 2.0e11
  dt1 = 1.0e4
  v_damp_n = 5.0, v_damp_steps = 5000, v_damp_ramp = 3000
  t_end = 1.0e9, n_step_max = 10000, dt_max = 1.0e4
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 60.0
  plot_at_end = .true.
/

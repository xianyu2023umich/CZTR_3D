! The atmosphere phase at 0.47 deg on Stampede3 (2026-11-15), with every fix
! Second try (2026-11-15): the first ran 4906 steps (1 h 43 min), then NaN at
! z = 208 km, lat -0.2, lon 63.5: 3.5 deg from the strongest flux cluster on
! the Sun (2.2 kG at lat -1.6, lon 59.8); the 1.875 deg crash sat on the
! second strongest. Now the field-strength heating saturated at 50 G
! (H_B_sat_G) and a box output around both (6 deg, z = -0.5..10 Mm, every 200
! steps: out_dir/box_rNNNN.dat, ~10 MB per output). For a 2 h job:
!   sbatch -N 4 --ntasks-per-node 112 -t 02:00:00 tools/job.stampede3_spr4 runs/real047_atm.nml
! (the job's limit stops it with a restart; ~1.26 s per step: ~5000 steps)
!
! from the 1.875 deg work: CZ_3D's mhd5 state (day 65.3) imported natively
! (no coarsening: its Yin-Yang boundary consistency kept), the discrete
! potential field (b_seed = 'dpf', compact; the PFSS at l = pi/dtheta = 384 as
! the start; 1.875 deg: 1331 iterations, 0.94 deg: 1480, so ~2000 expected),
! bounded Yin-Yang ghosts (always on), the frozen CZ through the ghost join
! boundary (freeze_side = 'cz': v = 0 at the join face, B_r and the photosphere
! fixed, B_h and psi free; the CZ keeps its convection and is not computed),
! the TR-margin background (data/init_wind20_dip_m600.dat), local time
! stepping without a cap in the atmosphere, no friction. The 1.875 deg version
! (runs/real1875_dpf.nml) ran 10000 steps clean.
! Before submitting:
!   - import_dir, out_dir: the absolute $SCRATCH paths (the namelist does not
!     expand $SCRATCH; `echo $SCRATCH`)
!   - ARBOR pulled and installed (bounded ghosts 831b389 or later), CZTR_3D
!     pulled and built, data/eos_table_wind.bin generated
! ~1.2e8 cells; memory ~150-200 GB; restarts ~10 GB each (every 30 s of
! model time); shell dumps at the end (photosphere, chromosphere, TR, low
! corona, 0.2 R, 0.6 R) instead of a plt (a 0.47 deg plt would be ~13 GB).
! The job's own time limit stops it with a restart (wall_time_margin 900 s).
!   sbatch -N 4 --ntasks-per-node 112 -t 12:00:00 tools/job.stampede3_spr4 runs/real047_atm.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/XXXX/CZ_3D/output/export_mhd5'
  out_dir = '/scratch/XXXX/CZTR_3D_out/real047_atm'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'cz'
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'dpf', dpf_maxit = 5000, b_seed_rss_rsun = 2.5
  b_bc_bottom = 'conductor', b_bc_top = 'radial'
  va_dt_target = 0.3, va_floor_cs = 1.5
  cond_along_b = .true., b_iso_G = 1.0e-3
  H_B = 4.0e-5, lambda_B_km = 4.0e4, n_gate = 2.0e11, H_B_sat_G = 50.0
  dt1 = 1.0e4
  t_end = 1.0e9, n_step_max = 10000, dt_max = 1.0e4
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 30.0
  dump_shells = 196, 197, 225, 244, 252, 280, 350, 450
  box_lat_deg = -1.0, box_lon_deg = 62.0, box_radius_deg = 6.0, box_z_km = -500.0, 10000.0, box_every = 200
  wall_time_margin = 900.0
/

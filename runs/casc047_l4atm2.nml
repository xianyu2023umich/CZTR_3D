! Atmosphere on the relaxed L4 (2026-11-28): casc047_l4's day-1.0 state
! (conductor top, k = 2; exported by runs/casc047_l4exp.nml) imported into the
! CZ + atmosphere grid (560 cells, join at cell 196 = the photosphere, outflow
! top), 3 h of model time. The second try at the atmosphere: casc047_l4atm
! (from L3, new layer at rest) died at 440 s in the atmosphere's own start
! (chromosphere heated 4400 -> 4830 K, TR lifted 1.6 -> 2-3 Mm, the low corona
! cooled to 0.01-0.35 MK, -44 km/s downflows, a column drained to rho = 0;
! no field involved). Two changes from it:
! - grey_atm_blocks = 0 (the grey radiation ends at the join), as hd047_cpl,
!   which ran 10000 steps stably; l4atm had 1 (from mhd047_cpl_nohb_mc);
! - the CZ below is the relaxed L4 (convecting to the photosphere, dt 0.83 s
!   there, close to the coupled step), not a new layer at rest.
! Physics otherwise as casc047_l4atm: physical pumping k = 1 (no wall), no
! mlt_wall_hp, field-free atmosphere (b_seed 'none'; L4's top field is ~20 G
! at most in rms), si_radial + si_alfven, wave cap 1 (c_s only), TRAC
! 5e5/1.2e4, conduction along B (mc limiter, cond_dB0_G 10), H_c + H_ext
! heating (H_B = 0), atm_match_base, no Alfven cap.
! - Watch (first hour): log.txt dt, Mach, min rho1/rho0, max v_A;
!   footpoints.txt (p_min at 1 Mm, min v_r, max Mach at 0-3 Mm); TR heights;
!   the mean T, rho at 0.3-4 Mm in the profiles (l4atm: the corona below 4 Mm
!   collapsed within ~350 s). If it fails the same way with grey off: v_damp
!   in the atmosphere for the first ~15 min.
! - 12 spr nodes (1152 columns, one per rank), ~0.35 s per step at dt ~0.5
!   s: 3 h of model time ~2.5-3 h.
!   (submitted together with runs/casc047_l4exp_local.nml, see casc047_l4exp.nml)
&cz3d
  import_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/casc047_l4exp'
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/casc047_l4atm2'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  turb_c_eta = 1.0, turb_c_nu = 1.0, turb_gamma_form = 'density', turb_gamma_k = 1.0
  rsst_depth_km = 500.0, rsst_q = -0.5, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'none', atm_match_base = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7, H_c = 3.0e-5, lambda_c_km = 4.0e4
  H_B = 0.0
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'none', b_bc_bottom = 'conductor', b_bc_top = 'radial'
  cond_along_b = .true., cond_limiter = 'mc', cond_dB0_G = 10.0, si_alfven = .true., wave_cfl_cs_only = .true.
  b_diff_form = 'resistive', b_eta_dr = 1.0
  omega_rot = 2.6e-6, lz_correct_steps = 20
  dt1 = 0.0, mr_levels = 0
  si_radial = .true., wave_cfl_max = 1.0, trac_Tc = 5.0e5, trac_Tlow = 1.2e4
  t_end = 6.53202e7, n_step_max = 100000000, dt_max = 20.0
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 3600.0
  dump_shells = 168, 190, 196, 197, 210, 225, 252, 350
  wall_time_margin = 900.0
  export_state = .true.
/

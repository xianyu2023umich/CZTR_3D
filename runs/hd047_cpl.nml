! Hydrodynamic chain at 0.47 deg (2026-11-19), step 2 of 2: the CZ of
! runs/hd047_czdt.nml (its export) with the atmosphere on top, everything
! free from t = 0. The same physics as runs/hd1875_cpl.nml (stable at 1.875
! deg on the Studio):
! - the atmosphere: one profile (init file) pressure-matched per column to the
!   CZ top below 1.2 Mm (atm_match_base); no field;
! - the radial semi-implicit solve over whole columns (si_radial; the columns,
!   not the blocks, distributed to ranks), a smooth radial wave cap 1
!   (wave_cfl_max), no dt cap (dt_max 20);
! - TR broadening (trac_Tc 5e5, trac_Tlow 1.2e4), hyperbolic conduction with
!   f_sat (default), the coronal heating H_c as CZTR_2D.
! 23040 blocks = 1152 columns of 20 blocks: 384 ranks (4 nodes x 96) give 3
! columns each (with 448 ranks some get 2, some 3). Expect dt ~0.5-1 s as
! at 1.875 deg (the radial grid is the same; the horizontal limits are far
! larger); ~0.7 s of wall per step (estimate): 2 h of model time ~2-3 h.
! Watch: log.txt (dt, Mach), footpoints.txt, the TR heights, profiles.
! A restart every 20 min of model time (~5 GB each).
!   sbatch -N 4 --ntasks-per-node 96 -t 05:00:00 tools/job.stampede3_spr4 runs/hd047_cpl.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/hd047_czdt'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/hd047_cpl'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'none', atm_match_base = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7, H_c = 3.0e-5, lambda_c_km = 4.0e4
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .false.
  dt1 = 0.0, mr_levels = 0
  si_radial = .true., wave_cfl_max = 1.0, trac_Tc = 5.0e5, trac_Tlow = 1.2e4
  t_end = 1.0e9, n_step_max = 10000, dt_max = 20.0
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 1200.0
  dump_shells = 196, 197, 225, 244, 252, 280, 350, 450
  wall_time_margin = 900.0
/

! Step 2 with the density-scaled field heating (2026-11-23): mhd047_cpl
! (below) with H_B_rho_exp = 1 (H_B x min(1, rho/rho0)), from the same import;
! A restart every 2 h of model time (~7 GB each). The long run in case it removes the crash (check: mhd047_dbgA2).
!   sbatch -N 6 --ntasks-per-node 96 -t 24:00:00 tools/job.stampede3_spr4 runs/mhd047_cpl_hbrho.nml
! Field chain at 0.47 deg (2026-11-20), step 2 of 2: the CZ of
! runs/mhd047_czdt.nml (its export: mhd5's CZ and field, settled at the
! coupled step) with the atmosphere on top, everything free from t = 0, as
! runs/hd047_cpl.nml (which ran 10000 steps clean) plus the field:
! - the atmosphere: one profile (init file) pressure-matched per column to the
!   CZ top below 1.2 Mm (atm_match_base);
! - b_smooth_cells = 1: the CZ field smoothed horizontally by one (0.47 deg)
!   cell, then the DPF potential field seeded above the join (b_seed 'dpf');
!   at 1.875 deg one cell cut the Yin-Yang corner force ~3x;
! - B diffusion as step 1: 'resistive' with eta = |v| dr/2; along-field
!   conduction (cond_dB0_G 10), si_alfven, the dt-based Alfven cap;
! - heating: hd047_cpl's height terms (H_c, H_ext) plus the field term
!   H_B |B|_sat exp(-z/lambda_B) gated by n_e (H_B 4e-5, 40 Mm, n_gate 2e11,
!   |B| saturated at 50 G: the settings of the earlier real-field runs;
!   2026-11-22, the user: the 0.47 crashes were not caused by the heating);
! - si_radial, wave cap 1, TRAC, global steps (as hd047_cpl).
! 1152 columns: 576 ranks (6 nodes x 96) give 2 each. The DPF solve runs once
! at the start (dpf_maxit 5000, as real047_atm).
! Watch: log.txt (dt, Mach, max|B|, div B), footpoints.txt, the TR heights,
! the shell dumps, the box (on the Yin corner where the corner force sat).
! grey_atm_blocks = 1 (2026-11-21): the grey radiation also in the first
! radial block above the join (to ~870 km), heating the low chromosphere: the
! T floor (4400 K) is then a safety net, no longer its heat source (1.4e6
! erg/cm2/s without it in the 1.875 test). Watch the floors report at the run's
! end and the low chromosphere's T in the profiles.
! The code of 2026-11-21 (6294f33, ARBOR b71f61b): timers, dt report, floors
! report at the end of the run / every log line; overlap_fills default on.
! A restart every 20 min of model time (MHD + atmosphere: ~7 GB each).
! Synthetic AIA images every 10 min of model time from 4 sides (lon 0, 90,
! 180, 270 at the equator; 512^2, +-1.3 R_sun; data/aia_response.dat):
! out_dir/euv_*.bin, plot with tools/euv_plot.py.
! With the same views: the AIA 1600/1700/4500 continua (LTE, phot_band_file;
! out_dir/photb_*.bin, DN/s/pix); the EUV table also carries 1600/1700 TR
! lines (C IV ...): tools/phot_plot.py photb_N.bin --euv euv_N.bin.
!   sbatch -N 6 --ntasks-per-node 96 -t 04:00:00 tools/job.stampede3_spr4 runs/mhd047_cpl.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/mhd047_czdt'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/mhd047_cpl_hbrho'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0, grey_atm_blocks = 1
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'none', atm_match_base = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7, H_c = 3.0e-5, lambda_c_km = 4.0e4
  H_B = 4.0e-5, lambda_B_km = 4.0e4, n_gate = 2.0e11, H_B_sat_G = 50.0, H_B_rho_exp = 1.0
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'dpf', dpf_maxit = 5000, b_seed_rss_rsun = 2.5, b_bc_bottom = 'conductor', b_bc_top = 'radial'
  b_smooth_cells = 1.0
  cond_along_b = .true., cond_dB0_G = 10.0, si_alfven = .true., wave_cfl_cs_only = .true.
  va_dt_target = 1.0, va_floor_cs = 1.5, b_diff_form = 'resistive', b_eta_dr = 1.0
  dt1 = 0.0, mr_levels = 0
  si_radial = .true., wave_cfl_max = 1.0, trac_Tc = 5.0e5, trac_Tlow = 1.2e4
  t_end = 1.0e9, n_step_max = 100000, dt_max = 20.0
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 7200.0
  dump_shells = 196, 197, 225, 244, 252, 280, 350, 450
  box_lat_deg = -44.0, box_lon_deg = 134.0, box_radius_deg = 3.0, box_z_km = -2000.0, 30000.0, box_every = 500
  euv_dt = 600.0, euv_n_view = 4, euv_lon_deg = 0.0, 90.0, 180.0, 270.0, euv_lat_deg = 0.0, 0.0, 0.0, 0.0
  euv_npix = 512, euv_fov_rsun = 1.3, euv_table = 'data/aia_response_uv.dat'
  phot_band_file = 'data/aia_uv_bands.dat'
  wall_time_margin = 900.0
/

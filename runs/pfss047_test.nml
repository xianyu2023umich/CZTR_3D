! 0.47 deg start test (zero steps): CZ_3D's mhd5 state (day 65.3, exported by
! CZ_3D/runs/export_mhd5.nml) imported into the CZ blocks (cells 1-196, by
! block key), the atmosphere (cells 197-560) from data/init_wind20_dip.dat
! (the horizontal means of the 1.875 deg dipole wind, wind3d_dipole step
! 40000, the same profile everywhere), the field above the join the PFSS of
! the CZ's own photospheric B_r (no dipole added). Reports on stdout: the
! fit's residual per pass ('pfss: ... pass'), the time ('field above the join
! set'), and the import. pfss_lmax = 300 (above the default pi/(2 dtheta) =
! 192: shows whether the fit still converges there and what it costs).
! Needs on Stampede3: CZTR_3D built (as CZ_3D: ./configure, make) and
! data/eos_table_wind.bin (not in git):
!   ../EOS/eos_hhe/build-omp/eos_table_gen data/eos_table_wind.nml
! Submit from the CZTR_3D directory (import_dir: where the export is):
!   sbatch -N 4 --ntasks-per-node 112 -t 00:30:00 tools/job.stampede3_spr4 runs/pfss047_test.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '../CZ_3D/output/export_mhd5'
  out_dir = 'output/pfss047_test'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_cz = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'pfss', b_seed_rss_rsun = 2.5, pfss_lmax = 300, pfss_iter = 6
  b_bc_bottom = 'conductor', b_bc_top = 'radial'
  va_dt_target = 0.3, va_floor_cs = 1.5
  cond_along_b = .true., b_iso_G = 1.0e-3
  H_B = 4.0e-5, lambda_B_km = 4.0e4, n_gate = 2.0e11
  t_end = 1.0e9, n_step_max = 0
  n_log = 20, dt_prof = 0.0, prof_every = 0, plot_dt = 0.0, restart_dt = 0.0
  wall_time_margin = 300.0
/

! PFSS test (zero steps, ~10 s on 8 ranks): the CZ field set to the analytic
! l = 1 dipole (b_seed_G, source surface b_seed_rss_rsun), then the field
! above the join rebuilt by b_seed = 'pfss' from the join cell's B_r alone and
! compared with the dipole ('pfss_check' line of the output; the fit's
! residual on the 'pfss: ... pass' lines).
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  out_dir = 'output/pfss_check'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, nb_r = 28
  use_atmosphere = .true., freeze_cz = .true.
  rho_floor = 1.0e-24
  use_B = .true., b_seed = 'pfss', pfss_check = .true., pfss_lmax = 48, b_seed_G = 5.0, b_seed_rss_rsun = 2.5
  b_bc_bottom = 'conductor', b_bc_top = 'radial'
  t_end = 1.0e9, n_step_max = 0
  n_log = 20, dt_prof = 0.0, prof_every = 0, plot_dt = 0.0, restart_dt = 0.0
/

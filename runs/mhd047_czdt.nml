! Field chain at 0.47 deg (2026-11-20), step 1 of 2 (as the hydrodynamic chain
! runs/hd047_czdt.nml -> hd047_cpl.nml): mhd5's CZ (CZ_3D
! c196_m0_r2c10_s3_mhd5, its 0.47 deg export) alone (n_r_cells = 0: the 196 CZ
! cells, top boundary as CZ_3D), continued with global steps at about the
! coupled run's step, with the B treatment of the coupled run from now on:
! b_diff_form 'resistive' with eta = |v| dr/2 (b_eta_dr 1; needs si_radial),
! the dt-based Alfven cap (va_dt_target 1, as the coupled run). The field
! keeps mhd5's state (b_seed 'none'); 2 h of model time lets the near-surface
! layer settle at this dt and diffusion, not the dynamo re-saturate. Then
! the export for step 2 (runs/mhd047_cpl.nml).
! dt_max 0.5: the coupled 1.875 deg MHD test ran at 0.2-0.46 s (set from
! hd047_cpl's dt if that differs much). Laptop check at 1.875 deg: starts,
! dt 0.5, exports. 1152 columns: 384 ranks (4 nodes x 96) give 3 each.
!   sbatch -N 4 --ntasks-per-node 96 -t 03:00:00 tools/job.stampede3_spr4 runs/mhd047_czdt.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 0
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/09595/xianyu2023/CZ_3D/output/export_mhd5'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/mhd047_czdt'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .false.
  use_B = .true., b_seed = 'none', b_bc_bottom = 'conductor', b_bc_top = 'radial'
  si_radial = .true., si_alfven = .true., wave_cfl_cs_only = .true.
  va_dt_target = 1.0, va_floor_cs = 1.5, b_diff_form = 'resistive', b_eta_dr = 1.0
  dt1 = 0.0, mr_levels = 0
  t_end = 1.0e9, n_step_max = 14400, dt_max = 0.5
  n_log = 100, dt_prof = 0.0, prof_every = 1200, plot_dt = 0.0, restart_dt = 1800.0
  dump_shells = 150, 180, 190, 196
  wall_time_margin = 600.0
  export_state = .true.
/

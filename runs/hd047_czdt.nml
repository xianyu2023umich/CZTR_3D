! Hydrodynamic chain at 0.47 deg (2026-11-19), step 1 of 2 (as the 1.875 deg
! chain runs/hd1875_czdt.nml -> hd1875_cpl.nml, which ran stably): the
! hydrodynamic CZ of CZ_3D's c196_m0_r2c10_s3 alone (no atmosphere:
! n_r_cells = 0 -> the 196 CZ cells, top boundary as CZ_3D), continued with
! global steps at the coupled run's step (s3 used local steps, dt1 = 10 s), so
! the near-surface layer settles at that step (CZTR_2D: cz_dt11). 2 h of model
! time at dt = 1.0 s, then an export for step 2 (runs/hd047_cpl.nml).
! First: runs/export_cz3d_hd047.nml (the s3 export). 8064 blocks; ~15-30 min
! on 4 nodes. Paths: Stampede3 $SCRATCH (edit if the export sits elsewhere).
!   sbatch -N 4 --ntasks-per-node 112 -t 01:30:00 tools/job.stampede3_spr4 runs/hd047_czdt.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 0
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/09595/xianyu2023/CZ_3D/output/export_hd047'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/hd047_czdt'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .false., use_B = .false.
  dt1 = 0.0, mr_levels = 0
  t_end = 1.0e9, n_step_max = 7200, dt_max = 1.0
  n_log = 100, dt_prof = 0.0, prof_every = 600, plot_dt = 0.0, restart_dt = 1800.0
  wall_time_margin = 600.0
  export_state = .true.
/

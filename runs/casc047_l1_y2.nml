! casc047_l1, second model year (2026-11-25): the continuation of
! runs/casc047_l1.nml from its final restart (t = 1 yr, step 224943), same
! settings and out_dir (log.txt and the profile/rotation series continue;
! the seed is not re-applied: the restart holds B). After year 1, E_mag/E_kin
! 1.27e-2, B_rms/B_eq ~0.1-0.14 at all depths and still growing (e-fold of
! E_mag ~9 months); the flow, flux and rotation steady since ~day 100.
! Year 1: 6.2 h on 6 nodes (75 SU); dt 133-140 s at the end, so ~6.5-7 h.
! runs/casc047_l1.nml's run_status.txt says 'finished', so job.stampede3_spr4
! would exit at once: submit with the plain job script
!   sbatch -N 6 --ntasks-per-node 96 -t 12:00:00 tools/job.stampede3_seq runs/casc047_l1_y2.nml
! (wall stop with a restart if needed; run_status.txt then names it).
&cz3d
  restart_from = '/scratch/09595/xianyu2023/CZTR_3D_out/casc047_l1/restart_00224943.rst'
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 112
  table_file = 'data/eos_table_wind.bin'

! Synthetic image test at 0.47 deg (2026-11-22): step 2's setup
! (runs/mhd047_cpl.nml) for 20 steps, then at the end the EUV images (AIA 94,
! 131, 171, 193, 211, 335 and the 1600/1700 TR lines: data/aia_response_uv.dat)
! and the AIA continuum bands (1600, 1700, 4500: phot_band_file), 4 views at
! the equator (lon 0, 90, 180, 270), 512^2, +-1.3 R_sun. The state is the
! near-initial one (the matched init atmosphere over mhd047_czdt's CZ, DPF
! field): a test of the image code and its cost on 576 ranks (stdout: the
! 'euv:' and 'phot:' lines with their times), not of the physics.
! out_dir/euv_*.bin, photb_*.bin: tools/euv_plot.py, tools/phot_plot.py --euv
!   sbatch -N 6 --ntasks-per-node 96 -t 00:20:00 tools/job.stampede3_spr4 runs/mhd047_img.nml
&cz3d
  grid_file = 'data/grid_atm20.dat', init_file = 'data/init_wind20_dip_m600.dat', n_r_cells = 560
  table_file = 'data/eos_table_wind.bin'
  import_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/mhd047_czdt'
  out_dir = '/scratch/09595/xianyu2023/CZTR_3D_out/mhd047_img'
  wall_top = 'outflow'
  top_energy = 'eddington', grey_tau_above = 0.01, grey_top_km = 1000.0, grey_atm_blocks = 1
  use_convection = .true., mlt_switch = .true., mlt_R0 = 1.0, mlt_p = 4.0
  rsst_depth_km = 500.0, rsst_q = 0.0, rsst_form = 'hotta2012'
  diffusion_heating = .true.
  diff_top_km = 500.0, diff_top_above_km = 50.0
  ds1_random = 0.0
  yy_margin = 0, n_theta = 48, n_phi = 144, nb_theta = 8, nb_phi = 24, refine_h = 2, nb_r = 28
  use_atmosphere = .true., freeze_side = 'none', atm_match_base = .true.
  rho_floor = 1.0e-24
  H_ext = 5.0e-7, lambda_ext_rsun = 0.7, H_c = 3.0e-5, lambda_c_km = 4.0e4
  cond_r_rsun = 5.0, alpha_cl = 1.05
  use_B = .true., b_seed = 'dpf', dpf_maxit = 500, b_seed_rss_rsun = 2.5, b_bc_bottom = 'conductor', b_bc_top = 'radial'
  b_smooth_cells = 1.0
  cond_along_b = .true., cond_dB0_G = 10.0, si_alfven = .true., wave_cfl_cs_only = .true.
  va_dt_target = 1.0, va_floor_cs = 1.5, b_diff_form = 'resistive', b_eta_dr = 1.0
  dt1 = 0.0, mr_levels = 0
  si_radial = .true., wave_cfl_max = 1.0, trac_Tc = 5.0e5, trac_Tlow = 1.2e4
  t_end = 1.0e9, n_step_max = 20, dt_max = 20.0
  n_log = 20, dt_prof = 0.0, prof_every = 200, plot_dt = 0.0, restart_dt = 0.0
  dump_shells = 196, 197, 225, 244, 252, 280, 350, 450
  box_lat_deg = -44.0, box_lon_deg = 134.0, box_radius_deg = 3.0, box_z_km = -2000.0, 30000.0, box_every = 500
  euv_dt = 0.0, euv_at_end = .true., euv_n_view = 4, euv_lon_deg = 0.0, 90.0, 180.0, 270.0, euv_lat_deg = 0.0, 0.0, 0.0, 0.0
  euv_npix = 512, euv_fov_rsun = 1.3, euv_table = 'data/aia_response_uv.dat'
  phot_band_file = 'data/aia_uv_bands.dat'
  wall_time_margin = 900.0
/
